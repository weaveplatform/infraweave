# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf

# Generated files are compared byte for byte with generator output, which
# writes LF on every OS; a CRLF checkout on Windows reads as drift.
api/reference/** text eol=lf
docs/research/reference/29-data-model-inventory.md text eol=lf
internal/devtools/specref/testdata/golden/** text eol=lf
api/*.openapi.yaml text eol=lf
api/src/** text eol=lf
*.gen.go text eol=lf
internal/devtools/openapibundle/testdata/golden/** text eol=lf
internal/agent/backend/testdata/** text eol=lf
# Recorded documents are as each vendor's tool wrote them, with LF endings;
# a CRLF checkout on Windows would change what the vendors' plan cases parse.
test/fixtures/vendor-documents/** text eol=lf
# Release files are checked against their vendors' signatures byte for byte;
# a CRLF checkout on Windows fails the signature.
internal/agent/tools/testdata/** -text

# Pinned MIT policy/notice bytes are hash-verified on every OS.
test/fixtures/rego-compatibility/** text eol=lf
internal/policies/internal/catalogue/upstream/** -text

# Recorded tool JSON/provenance has byte-exact NONE and checksum assertions.
test/fixtures/plan-payloads/** text eol=lf
