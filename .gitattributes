# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf

# Generated files are compared byte for byte with generator output, which
# writes LF on every OS; a CRLF checkout on Windows reads as drift.
api/reference/** text eol=lf
internal/specref/testdata/golden/** text eol=lf
