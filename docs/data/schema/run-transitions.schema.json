{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-transitions.schema.json",
  "title": "Run state transitions",
  "description": "Every edge of the run state machine: the 43 that report 08 records for Spacelift and the one decision 0008 adds. A pair of states with no record is not a transition. UNKNOWN and PENDING have no edges, so neither is a state here.",
  "x-id-pattern": "T[1-9][0-9]?",
  "x-cite-pattern": "\\bT[0-9]{1,2}\\b",
  "type": "object",
  "required": [
    "$schema",
    "records"
  ],
  "additionalProperties": false,
  "$defs": {
    "state": {
      "description": "A RunState value that has an edge.",
      "enum": [
        "QUEUED",
        "READY",
        "PREPARING",
        "INITIALIZING",
        "PLANNING",
        "PENDING_REVIEW",
        "UNCONFIRMED",
        "CONFIRMED",
        "REPLAN_REQUESTED",
        "PREPARING_REPLAN",
        "PREPARING_APPLY",
        "APPLYING",
        "DESTROYING",
        "PERFORMING",
        "FINISHED",
        "FAILED",
        "CANCELED",
        "DISCARDED",
        "STOPPED",
        "SKIPPED"
      ]
    }
  },
  "properties": {
    "$schema": {
      "const": "schema/run-transitions.schema.json"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "runTypes",
          "cause",
          "evidence",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "T and a number, never reused.",
            "type": "string"
          },
          "from": {
            "description": "The state the run leaves, or null for a run being created.",
            "oneOf": [
              {
                "$ref": "#/$defs/state"
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "description": "The state the run enters.",
            "$ref": "#/$defs/state"
          },
          "runTypes": {
            "description": "The RunType values that take the edge, or all for every type that reaches its source state.",
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "PROPOSED",
                    "TRACKED",
                    "TASK",
                    "TESTING",
                    "DESTROY"
                  ]
                }
              }
            ]
          },
          "cause": {
            "description": "What moves the run along the edge. The evidence markers are report 08's: [D] the docs, [G] the introspection schema, [RN] the changelog, [I] inferred.",
            "$ref": "common.schema.json#/$defs/markdown"
          },
          "evidence": {
            "description": "The sources for the edge, with their markers.",
            "$ref": "common.schema.json#/$defs/markdown"
          },
          "source": {
            "description": "Where the edge is recorded: report 08 for an edge Spacelift has, decision 0008 for one infraweave adds.",
            "enum": [
              "report 08",
              "decision 0008"
            ]
          }
        }
      }
    }
  }
}
