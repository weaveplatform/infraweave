{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graphql-inventory.schema.json",
  "title": "Every named type of Spacelift's GraphQL schema",
  "description": "Generated by make reference-inventory from api/reference/spacelift/introspection.json; report 29 summarises it. One record per type, its id the type name, ordered by kind and then by name. Upstream descriptions are left out: they carry no stated licence.",
  "x-id-pattern": "[_A-Za-z][_0-9A-Za-z]*",
  "type": "object",
  "required": ["$schema", "records"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "schema/graphql-inventory.schema.json"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/name"},
          "kind": {"enum": ["OBJECT", "INTERFACE", "UNION", "INPUT_OBJECT", "ENUM", "SCALAR"]},
          "implements": {"description": "The interfaces an object or interface implements.", "$ref": "#/$defs/names"},
          "implementedBy": {"description": "The types that implement an interface.", "$ref": "#/$defs/names"},
          "fields": {"type": "array", "minItems": 1},
          "values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/value"}},
          "members": {"description": "The object types a union may be.", "$ref": "#/$defs/names"}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"enum": ["OBJECT", "INTERFACE"]}}},
            "then": {
              "required": ["fields"],
              "properties": {"fields": {"items": {"$ref": "#/$defs/field"}}},
              "not": {"anyOf": [{"required": ["values"]}, {"required": ["members"]}]}
            }
          },
          {
            "if": {"properties": {"kind": {"const": "INPUT_OBJECT"}}},
            "then": {
              "required": ["fields"],
              "properties": {"fields": {"items": {"$ref": "#/$defs/input"}}},
              "not": {"anyOf": [{"required": ["values"]}, {"required": ["members"]}, {"required": ["implements"]}, {"required": ["implementedBy"]}]}
            }
          },
          {
            "if": {"properties": {"kind": {"const": "UNION"}}},
            "then": {
              "required": ["members"],
              "not": {"anyOf": [{"required": ["fields"]}, {"required": ["values"]}, {"required": ["implements"]}, {"required": ["implementedBy"]}]}
            }
          },
          {
            "if": {"properties": {"kind": {"const": "ENUM"}}},
            "then": {
              "required": ["values"],
              "not": {"anyOf": [{"required": ["fields"]}, {"required": ["members"]}, {"required": ["implements"]}, {"required": ["implementedBy"]}]}
            }
          },
          {
            "if": {"properties": {"kind": {"const": "SCALAR"}}},
            "then": {
              "not": {"anyOf": [{"required": ["fields"]}, {"required": ["values"]}, {"required": ["members"]}, {"required": ["implements"]}, {"required": ["implementedBy"]}]}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "name": {"description": "A GraphQL name.", "type": "string", "pattern": "^[_A-Za-z][_0-9A-Za-z]*$"},
    "names": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/name"}},
    "type": {
      "description": "A type reference in SDL notation, such as [String!]!.",
      "type": "string",
      "pattern": "^\\[*[_A-Za-z][_0-9A-Za-z]*!?(\\]!?)*$"
    },
    "deprecationReason": {"description": "Upstream's reason, present only when it gives one.", "type": "string", "minLength": 1},
    "field": {
      "description": "An output field of an object or interface.",
      "type": "object",
      "required": ["name", "type", "nullable"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "args": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
        "type": {"$ref": "#/$defs/type"},
        "nullable": {"description": "False when the type ends in !.", "type": "boolean"},
        "deprecated": {"const": true},
        "deprecationReason": {"$ref": "#/$defs/deprecationReason"}
      },
      "dependentRequired": {"deprecationReason": ["deprecated"]}
    },
    "input": {
      "description": "An input object field or a field argument. The snapshot's introspection query does not ask for input field deprecation, so there is none.",
      "type": "object",
      "required": ["name", "type", "nullable"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "type": {"$ref": "#/$defs/type"},
        "nullable": {"description": "False when the type ends in !.", "type": "boolean"},
        "default": {"description": "The default value in GraphQL syntax.", "type": "string"}
      }
    },
    "value": {
      "description": "An enum value.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "deprecated": {"const": true},
        "deprecationReason": {"$ref": "#/$defs/deprecationReason"}
      },
      "dependentRequired": {"deprecationReason": ["deprecated"]}
    }
  }
}
