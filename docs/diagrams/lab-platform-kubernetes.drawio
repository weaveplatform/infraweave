        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="One Terraform root, test/terraform/lab/services, creates the Docker services under one owner. The Go harness, not Terraform, starts the infraweave servers, launchers and worker controllers as host processes. Every container publishes only to a random 127.0.0.1 port. The kubernetes batch adds k3s, whose run Pods reach the servers through the scenario&#x27;s HTTPS front." vertex="1">
          <mxGeometry height="32" width="1600" x="30" y="52" as="geometry" />
        </mxCell>
        <mxCell id="ctl" parent="1" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#1b1e2b;strokeColor=#64748b;strokeWidth=1.2;dashed=1;" value="" vertex="1">
