        <mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="One listener serves four surfaces behind the same router and controls; each accepts only its own credentials, so no token of one authenticates on another. Three are APIs, each from its own OpenAPI document with a generated server and client: /api/v1, public and supported; /operator/v1, the operator&#39;s alone; /worker/v1, the launcher&#39;s internal protocol. /state/v1 speaks Terraform&#39;s http backend protocol through a hand-written handler, and departs from the shared controls only where decision 0003 records it." vertex="1">
          <mxGeometry height="52" width="950" x="30" y="52" as="geometry" />
        </mxCell>
