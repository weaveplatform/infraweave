        </mxCell>
        <mxCell id="note-t" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#f5b13d;align=center;verticalAlign=middle;spacing=2;" value="What is a strict server?" vertex="1">
          <mxGeometry height="22" width="170" x="420" y="829" as="geometry" />
        </mxCell>
        <mxCell id="note-x" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#c8ccda;align=left;verticalAlign=top;spacing=0;" value="The typed handler that oapi-codegen writes from a contract (strict-server: true in api/oapi-server-&amp;lt;svc&amp;gt;.yaml). Each operation becomes a Go method that takes a typed request (path, query, headers and the decoded JSON body) and returns one of the typed responses the contract declares, so a handler cannot answer a shape the contract lacks. The generated wrapper decodes and writes the HTTP, and an error becomes a problem+json answer; the domain code implements only the methods. It types requests but does not validate bounds or unknown fields: the shared router checks those before the handler, on every surface." vertex="1">
          <mxGeometry height="68" width="914" x="48" y="856" as="geometry" />
        </mxCell>
