        <mxCell id="cap0" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#1d2030;strokeColor=#3a3f55;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;Paths&lt;/b&gt;&lt;br&gt;/worker/v1, signed object URLs and /state/v1 all use the tunnel host. cloudflared forwards to the HTTPS front, which balances over servers A and B; the servers sign object URLs with the tunnel origin." vertex="1">
          <mxGeometry height="100" width="373" x="30" y="860" as="geometry" />
        </mxCell>
        <mxCell id="cap1" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#1d2030;strokeColor=#3a3f55;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;Trust anchors and egress&lt;/b&gt;&lt;br&gt;Pods trust system roots: Cloudflare&#x27;s certificate on the tunnel host. cloudflared trusts the front&#x27;s CA. Pods need outbound 443 through each cloud&#x27;s NAT; the runner needs only outbound connections." vertex="1">
          <mxGeometry height="100" width="373" x="419" y="860" as="geometry" />
        </mxCell>
        <mxCell id="cap2" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#1d2030;strokeColor=#3a3f55;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;For&lt;/b&gt;&lt;br&gt;No server stack in any cloud. The platform, its coverage and its cleanup stay on the runner like every other lab batch. Smallest scope and cost." vertex="1">
          <mxGeometry height="100" width="373" x="808" y="860" as="geometry" />
        </mxCell>
        <mxCell id="cap3" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#1d2030;strokeColor=#3a3f55;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;Against&lt;/b&gt;&lt;br&gt;Every Pod request crosses Cloudflare and the runner&#x27;s uplink. A quick tunnel has no SLA and a new host each run; a named tunnel adds an account, a domain and a token secret. The control plane is public for the run." vertex="1">
          <mxGeometry height="100" width="373" x="1197" y="860" as="geometry" />
        </mxCell>
