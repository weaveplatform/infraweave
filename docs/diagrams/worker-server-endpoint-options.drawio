        <mxCell id="cap0" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#1d2030;strokeColor=#3a3f55;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;Paths&lt;/b&gt;&lt;br&gt;/worker/v1 and /state/v1 go to the ALB; signed object URLs point at S3 directly. The runner&#x27;s scenarios and all three clusters use the same public origin." vertex="1">
          <mxGeometry height="100" width="373" x="30" y="860" as="geometry" />
        </mxCell>
        <mxCell id="cap1" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#1d2030;strokeColor=#3a3f55;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;Trust anchors and egress&lt;/b&gt;&lt;br&gt;Pods and the runner trust system roots: the public certificates of the lab domain and S3. EKS reaches the ALB inside AWS; AKS and GKE egress through their NAT to it." vertex="1">
          <mxGeometry height="100" width="373" x="419" y="860" as="geometry" />
