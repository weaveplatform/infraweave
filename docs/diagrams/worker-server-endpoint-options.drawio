        <mxCell id="cap0" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#1d2030;strokeColor=#3a3f55;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;Paths&lt;/b&gt;&lt;br&gt;Pods call one private hostname that each cluster&#x27;s private DNS resolves to its own relay, so one signed-URL origin serves every cloud. Each relay forwards over the runner&#x27;s tunnel to the HTTPS front." vertex="1">
          <mxGeometry height="100" width="373" x="30" y="860" as="geometry" />
        </mxCell>
        <mxCell id="cap1" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#1d2030;strokeColor=#3a3f55;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;Trust anchors and egress&lt;/b&gt;&lt;br&gt;Pods trust the lab CA; each relay presents a certificate for the private hostname. Pods need no internet route to the control plane; each relay needs an ingress the runner can reach." vertex="1">
          <mxGeometry height="100" width="373" x="419" y="860" as="geometry" />
        </mxCell>
        <mxCell id="cap2" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#1d2030;strokeColor=#3a3f55;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;For&lt;/b&gt;&lt;br&gt;No third-party tunnel and no public control plane. Each cloud&#x27;s path is independent, so disrupting one relay isolates one cloud." vertex="1">
          <mxGeometry height="100" width="373" x="808" y="860" as="geometry" />
        </mxCell>
        <mxCell id="cap3" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#1d2030;strokeColor=#3a3f55;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;Against&lt;/b&gt;&lt;br&gt;Three more components to build, pin, secure and clean up, plus private DNS and an ingress per cloud. More failure modes; a relay fault can look like a worker fault." vertex="1">
